# cvforge settings. Every key is optional; the values below are the defaults.

theme = "classic"
pages = 2                    # maximum page count
paper = "a4"                 # "a4" | "us-letter"
formats = ["pdf", "docx", "txt", "md"]

date_format = "%b %Y"        # how YYYY-MM dates are displayed: Jun 2023
company_suffix = false       # true: Jane_Doe_Resume_Acme.pdf
max_file_mb = 2.0

section_order = [
  "summary",
  "skills",
  "experience",
  "projects",
  "education",
  "certifications",
  "awards",
  "publications",
  "languages",
  "extra_sections",
]

# --- ingestion ---
drop_sections = ["references"]   # source headings left out of the resume; every drop is reported
keywords_path = "keywords.txt"   # extra keywords verify must never lose (bundled list if absent)
llm_model = "claude-opus-5-5"    # only used by --extractor anthropic (needs ANTHROPIC_API_KEY)
watch_dirs = []                  # folders `cvforge watch` monitors when none are given

# Tables below ADD to the built-in defaults (see src/cvforge/config.py for the full lists).
#
# [heading_synonyms]             # source heading -> schema section; unknown headings stay as-is
# projects = ["projects", "technical contributions"]
#
# [html_classes]                 # HTML class -> role (org, title, dates, location, ...)
# "role-name" = "title"
#
# [latex_macros]                 # macro -> role of each {argument}; "" ignores one
# resumeSubheading = ["org", "location", "title", "dates"]
